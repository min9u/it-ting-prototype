# 디굴디굴 프론트엔드(Next.js) 환경 변수 목록 (이 파일은 설명용이라 커밋함. 실제 값은 .env.local 에)
# - 값은 항상 "문자열"로 들어옴. 켜기/끄기는 1/0 (src/lib/env.ts flag() 가 "0"·"false" 를 거짓으로 읽음)
# - NEXT_PUBLIC_ 로 시작하는 값은 빌드 결과 JS 에 그대로 박혀 누구나 볼 수 있음 → 비밀 키·DB 주소·관리자 토큰 금지
# - 빌드할 때 정해짐: NEXT_PUBLIC_* 를 바꾸면 다시 빌드(next build)하거나 개발 서버를 다시 켜야 함
# - 개인 설정은 frontend/.env.local (gitignore 됨)
# - 코드에서 읽을 때는 process.env 대신 src/lib/env.ts 의 ENV (예외: src/labs/index.ts, 까닭은 그 파일 주석)

# 실험실(🧪 저사양 패널 · 목 서버 손잡이 배지 · /lab/style · /lab/rooms · /screens · /dev/crash)
# 비워 두면 next dev 는 켜고 next build 는 끔. 테스트 서버 빌드에서만 켜려면 NEXT_PUBLIC_LABS=1 npm run build
NEXT_PUBLIC_LABS=

# REST 기준 주소 (백엔드 명세 v1 은 모든 주소가 /api/v1 로 시작). 같은 출처 상대 경로를 추천 (개발: next.config.ts rewrites, 배포: Nginx 가 /api 를 Spring 으로)
NEXT_PUBLIC_API_BASE=/api/v1

# API 방식: mock(목 서버, 기본) · real(실제 서버). 모든 영역의 기본값
NEXT_PUBLIC_API_MODE=mock
# 이 영역만 실제 서버로 (쉼표). 영역: common auth settings onboarding burrow explore chat meetups community notifications admin, 실시간 소식 연결은 events
# 예: 백엔드가 구현한 캠퍼스 · 기수 · 로그인만 실제로 → NEXT_PUBLIC_API_REAL_AREAS=common,auth
NEXT_PUBLIC_API_REAL_AREAS=
# NEXT_PUBLIC_API_MODE=real 이어도 목으로 둘 영역 (백엔드가 아직 안 만든 영역)
NEXT_PUBLIC_API_MOCK_AREAS=

# 로그인 검사 끄기 (시연 · 디자인 확인용). 비우거나 0 이면 명세대로 로그인 · 온보딩을 검사
# 1 이면 로그인 없이 모든 화면이 열리고 로그인은 입력과 관계없이 성공, 401 도 무시
NEXT_PUBLIC_LOGIN_FREE=

# (next.config.ts 가 읽음, 브라우저 코드에는 안 들어감) /api/v1/* (실시간 소식 SSE 포함)를 넘길 백엔드 주소.
# 기본 http://localhost:8080 (백엔드 CORS 허용 출처는 http://localhost:3000 = next dev 기본 포트), off 면 넘기지 않음
# API_PROXY_TARGET=http://localhost:8080
