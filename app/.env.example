# 디굴디굴 프론트엔드 환경 변수 목록 (이 파일은 설명용이라 커밋함. 실제 값은 .env.local 에)
# - 값은 항상 "문자열"로 들어옴. 켜기/끄기는 1/0 (src/lib/env.ts flag() 가 "0"·"false" 를 거짓으로 읽음)
# - VITE_ 로 시작하는 값은 빌드 결과 JS 에 그대로 박혀 누구나 볼 수 있음 → 비밀 키·DB 주소·관리자 토큰 금지
# - 개인 설정은 app/.env.local (gitignore 됨). 공유 빌드는 .env.share (--mode share)
# - 코드에서 읽을 때는 import.meta.env 대신 src/lib/env.ts 의 ENV

# # 라우팅 (주소 경로를 못 바꾸는 곳에 올릴 때만 1). 일반 서버 배포는 0 또는 비움 → 브라우저 라우터 + Nginx try_files
VITE_HASH_ROUTER=0

# REST 기준 주소. 같은 출처 상대 경로를 추천 (개발: vite 프록시, 배포: Nginx 가 /api 를 Spring 으로)
VITE_API_BASE=/api

# WebSocket(STOMP) 주소. 상대 경로면 페이지 출처에 ws:// 또는 wss:// 를 붙임
VITE_WS_URL=/ws

# 채팅·알림 실시간 연결: mock(서버 없이 흉내, 기본) · stomp(실제 서버)
VITE_REALTIME=mock

# (vite.config.ts 가 읽음, 브라우저 코드에는 안 들어감) 개발 서버가 /api·/ws 를 넘길 백엔드 주소. 비우면 프록시 안 씀
# DEV_PROXY_TARGET=http://localhost:8080
