# 디굴디굴 프론트엔드 환경 변수 목록 (이 파일은 설명용이라 커밋함. 실제 값은 .env.local 에)
# - 값은 항상 "문자열"로 들어옴. 켜기/끄기는 1/0 (src/lib/env.ts flag() 가 "0"·"false" 를 거짓으로 읽음)
# - VITE_ 로 시작하는 값은 빌드 결과 JS 에 그대로 박혀 누구나 볼 수 있음 → 비밀 키·DB 주소·관리자 토큰 금지
# - 개인 설정은 app/.env.local (gitignore 됨). 공유 빌드는 .env.share (--mode share)
# - 코드에서 읽을 때는 import.meta.env 대신 src/lib/env.ts 의 ENV

# # 라우팅 (주소 경로를 못 바꾸는 곳에 올릴 때만 1). 일반 서버 배포는 0 또는 비움 → 브라우저 라우터 + Nginx try_files
VITE_HASH_ROUTER=0

# REST 기준 주소 (백엔드 명세 v1 은 모든 주소가 /api/v1 로 시작). 같은 출처 상대 경로를 추천 (개발: vite 프록시, 배포: Nginx 가 /api 를 Spring 으로)
VITE_API_BASE=/api/v1

# API 방식: mock(목 서버, 기본) · real(실제 서버). 모든 영역의 기본값
VITE_API_MODE=mock
# 이 영역만 실제 서버로 (쉼표). 영역: common auth settings onboarding burrow explore chat meetups community notifications admin, 실시간 소식 연결은 events
# 예: 백엔드가 구현한 캠퍼스 · 기수 · 로그인만 실제로 → VITE_API_REAL_AREAS=common,auth
VITE_API_REAL_AREAS=
# VITE_API_MODE=real 이어도 목으로 둘 영역 (백엔드가 아직 안 만든 영역)
VITE_API_MOCK_AREAS=

# WebSocket(STOMP) 주소. 상대 경로면 페이지 출처에 ws:// 또는 wss:// 를 붙임
VITE_WS_URL=/ws

# 채팅·알림 실시간 연결: mock(서버 없이 흉내, 기본) · stomp(실제 서버)
VITE_REALTIME=mock

# (vite.config.ts 가 읽음, 브라우저 코드에는 안 들어감) 개발 서버가 /api·/ws 를 넘길 백엔드 주소. 기본 http://localhost:8080, off 면 프록시 안 씀
# DEV_PROXY_TARGET=http://localhost:8080
